# ============================================================================
# Environment Variables — copy to .env (local) and set in Vercel (production)
# ============================================================================
# See docs/deployment.md and DEPLOYMENT.md for the full deployment walkthrough.
#
# Where each variable belongs:
#   • VITE_*  → Vercel "Environment Variables" (Production + Preview + Dev).
#               These are inlined into the client bundle at build time.
#               Safe to expose — they are public by design.
#   • SUPABASE_SERVICE_ROLE_KEY / SUPABASE_DB_URL → Vercel only, marked as
#               "Sensitive". NEVER expose to the client, NEVER prefix VITE_.
#   • Supabase backend secrets (SMS, WhatsApp, Email) are configured at
#               runtime via Super Admin → Settings, stored in platform_settings.
# ============================================================================


# ── Supabase: client (public — safe in browser bundle) ──────────────────────
# Vercel: Production + Preview + Development
# Source: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=


# ── Supabase: server (TanStack server functions & API routes) ───────────────
# Vercel: Production + Preview + Development (NOT prefixed with VITE_)
# Mirror of the VITE_ values above — read via process.env on the server.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ── Supabase: privileged (server-only, mark "Sensitive" in Vercel) ──────────
# SERVICE_ROLE_KEY bypasses RLS — use only in *.server.ts files behind
# requireSupabaseAuth + role checks. Never import into client code.
# Source: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string — used by `supabase db push` migrations
# and any server-side admin script. Not needed at runtime.
# Source: Supabase Dashboard → Project Settings → Database → Connection string
SUPABASE_DB_URL=


# ── App configuration ───────────────────────────────────────────────────────
# Vercel: Production + Preview + Development
# APP_URL is the canonical public origin (used for email links, OAuth
# redirects). VITE_APP_URL is the same value, exposed client-side (used for
# OG tags, canonical links, JSON-LD — see src/lib/site-url.ts). Keep both in
# sync. Set per environment:
#   Production      → https://your-domain.com
#   Preproduction   → https://clinicflow-preprod.vercel.app
#   Development     → http://localhost:8080
APP_URL=http://localhost:8080
VITE_APP_URL=http://localhost:8080
NODE_ENV=production


# ── Bootstrap super admin (one-time) ────────────────────────────────────────
# Vercel: Production only. Secret required (in addition to the fixed
# allowed email, hardcoded in superadmin.functions.ts) to claim the first
# super_admin role via /superadmin/login. Self-sealing — the bootstrap path
# is permanently disabled after the first successful call, regardless of
# this value. Generate with: openssl rand -hex 32
BOOTSTRAP_SETUP_TOKEN=


# ── SMS provider (MSG91 / Twilio / Gupshup / dev) ───────────────────────────
# Configured at runtime via Super Admin → Settings → SMS Provider
# (stored in platform_settings.sms JSONB). No env vars required unless you
# ship a custom adapter that reads process.env.

# ── WhatsApp: Interakt ──────────────────────────────────────────────────────
# Configured at runtime via platform_settings.whatsapp JSONB.

# ── Email: Resend ───────────────────────────────────────────────────────────
# Configured at runtime via platform_settings.email JSONB.


# ── Smoke tests (optional — tests skip when blank) ──────────────────────────
SMOKE_TEST_CLINIC_SLUG=
SMOKE_TEST_DOCTOR_ID=
SMOKE_TEST_CLINIC_ID=
